          <mxGeometry x="40" y="240" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="row2-aw" value="&lt;b&gt;Organization-Scoped Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Per-customer agent isolation&lt;br&gt;Compliance-aware routing rules&lt;br&gt;Audit trail per organization&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
