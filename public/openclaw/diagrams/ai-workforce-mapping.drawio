        <!-- Row 1: Gateway Pattern -->
        <mxCell id="row1-oc" value="&lt;b&gt;Gateway-Centric Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Single WebSocket control plane&lt;br&gt;Multiplexed HTTP + WS on one port&lt;br&gt;Token-based authentication&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="row1-aw" value="&lt;b&gt;Unified API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Single entry point for all Opsfolio agents&lt;br&gt;Customer-scoped authentication&lt;br&gt;FOPC/CIVCO/POCN/TechBD routing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="140" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="row1-tech" value="&lt;b&gt;Spry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;HTTP Framework&lt;br&gt;WS Support&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="140" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Row 2: Multi-Agent -->
