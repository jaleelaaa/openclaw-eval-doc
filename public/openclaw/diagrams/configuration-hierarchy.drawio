          <mxGeometry x="400" y="465" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="provider-content" value="&lt;b&gt;Google Gemini&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size:9px&quot;&gt;model: &quot;google/gemini-3-flash-preview&quot;&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Requires: GOOGLE_API_KEY&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Anthropic Claude&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size:9px&quot;&gt;model: &quot;anthropic/claude-sonnet&quot;&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Requires: ANTHROPIC_API_KEY&lt;/font&gt;&lt;hr&gt;&lt;b&gt;OpenAI&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size:9px&quot;&gt;model: &quot;openai/gpt-4&quot;&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Requires: OPENAI_API_KEY&lt;/font&gt;&lt;hr&gt;&lt;b&gt;Local (Ollama)&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size:9px&quot;&gt;model: &quot;ollama/llama3&quot;&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#FFAB91;fontSize=11;fontColor=#1a1a2e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
