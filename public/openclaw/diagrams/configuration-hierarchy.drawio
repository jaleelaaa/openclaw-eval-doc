          <mxGeometry x="770" y="465" width="290" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="channel-content" value="&lt;b&gt;WhatsApp (QR Code)&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size:9px&quot;&gt;openclaw providers login&lt;/code&gt;&lt;hr&gt;&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size:9px&quot;&gt;openclaw providers add \&lt;br&gt;  --provider telegram \&lt;br&gt;  --token &amp;lt;bot_token&amp;gt;&lt;/code&gt;&lt;hr&gt;&lt;b&gt;Discord&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size:9px&quot;&gt;openclaw providers add \&lt;br&gt;  --provider discord \&lt;br&gt;  --token &amp;lt;bot_token&amp;gt;&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B39DDB;fontSize=11;fontColor=#1a1a2e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
