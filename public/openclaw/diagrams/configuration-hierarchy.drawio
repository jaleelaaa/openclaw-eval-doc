          <mxGeometry x="50" y="465" width="320" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="fs-content" value="&lt;pre style=&quot;text-align:left;font-size:10px;font-family:Courier New&quot;&gt;~/.openclaw/&lt;br&gt;├── openclaw.json      # Main config&lt;br&gt;├── openclaw.json.bak  # Backup&lt;br&gt;├── agents/            # Per-agent state&lt;br&gt;│   └── &amp;lt;agentId&amp;gt;/&lt;br&gt;│       ├── agent/&lt;br&gt;│       └── sessions/&lt;br&gt;├── canvas/            # File server&lt;br&gt;├── cron/              # Scheduled tasks&lt;br&gt;├── identity/          # Device keys&lt;br&gt;└── workspace/         # Agent files&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#80CBC4;fontSize=10;fontColor=#1a1a2e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="300" height="220" as="geometry"/>
        </mxCell>

        <!-- Provider Configuration -->
