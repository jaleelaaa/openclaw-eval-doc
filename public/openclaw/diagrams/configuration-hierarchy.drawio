        <!-- Config JSON -->
        <mxCell id="config-json" value="&lt;pre style=&quot;text-align:left;font-size:10px;font-family:Courier New&quot;&gt;{&lt;br&gt;  &quot;gateway&quot;: {&lt;br&gt;    &quot;auth&quot;: { &quot;token&quot;: &quot;...&quot; },&lt;br&gt;    &quot;port&quot;: 18789,&lt;br&gt;    &quot;bind&quot;: &quot;lan&quot;&lt;br&gt;  },&lt;br&gt;  &quot;agents&quot;: {&lt;br&gt;    &quot;defaults&quot;: { &quot;model&quot;: {...} }&lt;br&gt;  },&lt;br&gt;  &quot;channels&quot;: { ... },&lt;br&gt;  &quot;plugins&quot;: [ ... ]&lt;br&gt;}&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7986CB;fontSize=10;fontColor=#1a1a2e;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="175" width="440" height="250" as="geometry"/>
