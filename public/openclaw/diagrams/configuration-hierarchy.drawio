        <!-- Priority Flow -->
        <mxCell id="priority-box" value="&lt;b&gt;Configuration Priority (High to Low):&lt;/b&gt; &lt;font color=&quot;#e74c3c&quot;&gt;&lt;b&gt;CLI Arguments&lt;/b&gt;&lt;/font&gt; → &lt;font color=&quot;#e74c3c&quot;&gt;&lt;b&gt;Environment Variables&lt;/b&gt;&lt;/font&gt; → &lt;font color=&quot;#f39c12&quot;&gt;&lt;b&gt;openclaw.json&lt;/b&gt;&lt;/font&gt; → &lt;font color=&quot;#27ae60&quot;&gt;&lt;b&gt;Default Values&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#FF9800;fontSize=12;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="50" y="75" width="1000" height="35" as="geometry"/>
        </mxCell>

        <!-- Environment Variables Section -->
        <mxCell id="env-section" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#E91E63;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="500" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="env-header" value="Environment Variables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E91E63;strokeColor=#C2185B;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="500" height="35" as="geometry"/>
        </mxCell>

        <!-- Required Env Vars -->
        <mxCell id="env-required" value="&lt;b&gt;Required / Recommended&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;OPENCLAW_GATEWAY_TOKEN&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Gateway authentication (64-char hex)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;OPENCLAW_CONFIG_DIR&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Default: ~/.openclaw&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;OPENCLAW_WORKSPACE_DIR&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Default: ~/.openclaw/workspace&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;OPENCLAW_GATEWAY_PORT&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Default: 18789&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;OPENCLAW_GATEWAY_BIND&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Options: lan, localhost, 0.0.0.0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#F48FB1;fontSize=11;fontColor=#1a1a2e;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="175" width="220" height="250" as="geometry"/>
        </mxCell>

        <!-- Optional Env Vars -->
        <mxCell id="env-optional" value="&lt;b&gt;Optional / Provider Keys&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;CLAUDE_AI_SESSION_KEY&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Anthropic Claude session&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;GOOGLE_API_KEY&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Google Gemini access&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;OPENAI_API_KEY&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OpenAI API access&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;ANTHROPIC_API_KEY&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Anthropic API access&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;TWILIO_*&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Twilio WhatsApp integration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#F48FB1;fontSize=11;fontColor=#1a1a2e;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
